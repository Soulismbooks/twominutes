{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twominutes-admin-ui",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "services": [
    {
      "binding": "ADMIN_API",
      "service": "twominutes-admin-api"
    }
  ]
}
